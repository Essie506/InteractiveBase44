{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "professional",
        "business"
      ],
      "title": "Target Type"
    },
    "target_id": {
      "type": "string",
      "title": "Target ID",
      "description": "Identity ID (professional) or Business ID (business)"
    },
    "verification_type": {
      "type": "string",
      "title": "Verification Type",
      "description": "e.g. identity, professional, business"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_verified",
        "pending_review",
        "additional_info_required",
        "verified",
        "failed",
        "expired"
      ],
      "default": "pending_review",
      "title": "Verification Status"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "additional_info_required",
        "expired"
      ],
      "default": "pending",
      "title": "Review Decision"
    },
    "public_state": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "new",
        "rejected",
        "expired"
      ],
      "title": "Public State",
      "description": "Authoritative public state for display on profiles"
    },
    "submitted_by_id": {
      "type": "string",
      "title": "Submitted By ID"
    },
    "evidence_url": {
      "type": "string",
      "title": "Evidence URL (legacy)"
    },
    "evidence_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Evidence Media IDs",
      "description": "Stable references to protected MediaAsset records"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "trust_explanation": {
      "type": "string",
      "title": "Trust Explanation",
      "description": "Public text explaining the verification decision"
    },
    "reviewed_by_id": {
      "type": "string",
      "title": "Reviewed By ID"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "verification_type",
    "submitted_by_id"
  ]
}