{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "professional",
        "business"
      ],
      "title": "Target Type"
    },
    "target_id": {
      "type": "string",
      "title": "Target ID",
      "description": "Identity ID (professional) or Business ID (business)"
    },
    "verification_type": {
      "type": "string",
      "title": "Verification Type",
      "description": "e.g. identity, professional, business"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_verified",
        "pending_review",
        "additional_info_required",
        "verified",
        "failed",
        "expired"
      ],
      "default": "pending_review",
      "title": "Verification Status"
    },
    "submitted_by_id": {
      "type": "string",
      "title": "Submitted By ID"
    },
    "evidence_url": {
      "type": "string",
      "title": "Evidence URL"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "verification_type",
    "submitted_by_id"
  ]
}