{
  "name": "PersonalProfile",
  "type": "object",
  "properties": {
    "identity_id": {
      "type": "string",
      "title": "Identity ID",
      "description": "Stable reference to the authenticated Interactive identity (User)"
    },
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "screen_name": {
      "type": "string",
      "title": "Screen Name"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL"
    },
    "avatar_media_id": {
      "type": "string",
      "title": "Avatar Media ID",
      "description": "Stable reference to the MediaAsset used as the profile image"
    },
    "avatar_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Avatar Focal Point X",
      "description": "Horizontal focal point (0-1) for avatar rendering"
    },
    "avatar_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Avatar Focal Point Y",
      "description": "Vertical focal point (0-1) for avatar rendering"
    },
    "avatar_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Avatar Zoom",
      "description": "Zoom factor for avatar rendering"
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the cover image"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL",
      "description": "Display URL for the cover image (resolved from MediaAsset)"
    },
    "cover_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point X"
    },
    "cover_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point Y"
    },
    "cover_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Cover Zoom"
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "headline": {
      "type": "string",
      "title": "Headline"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Interests",
      "description": "Personal interests / fitness interests"
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private"
      ],
      "default": "public",
      "title": "Visibility"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    }
  },
  "required": [
    "identity_id",
    "display_name"
  ]
}