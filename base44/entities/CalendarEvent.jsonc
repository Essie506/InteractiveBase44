{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "title": "Owner ID",
      "description": "Stable reference to the identity or business that owns this calendar event. For owner_type 'identity' this is the stable Interactive identity ID (Personal and Professional are operating contexts of ONE identity, NOT separate owners). For owner_type 'business' this is the businessId. Never an email."
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "identity",
        "business"
      ],
      "default": "identity",
      "title": "Owner Type",
      "description": "identity = an Interactive identity owns the event (Personal/Professional are operating_context provenance, not separate owners). business = a Business organisation owns the event. 'professional' is NOT an owner type \u2014 Professional is an operating_context."
    },
    "operating_context": {
      "type": "string",
      "enum": [
        "personal",
        "professional",
        "business"
      ],
      "default": "personal",
      "title": "Operating Context",
      "description": "Provenance/presentation: the context in which this event was created. NOT ownership. Personal and Professional are operating contexts of the same identity; switching context does not change the owner."
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time",
      "description": "ISO 8601 datetime (stored in UTC). For a recurring series, this is the first occurrence start (DTSTART)."
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time",
      "description": "ISO 8601 datetime (stored in UTC). For a recurring series, this is the first occurrence end; subsequent occurrences derive their end from this + duration."
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "title": "Timezone",
      "description": "IANA timezone identifier for display (e.g. Europe/London)"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "title": "All Day"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "physical",
        "online",
        "hybrid"
      ],
      "default": "physical",
      "title": "Location Type"
    },
    "meeting_url": {
      "type": "string",
      "title": "Meeting URL",
      "description": "Private \u2014 never projected to calendarEventsPublic. Revealed only through the booking/attendance flow."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private",
        "staff"
      ],
      "default": "private",
      "title": "Visibility"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "tentative",
        "cancelled",
        "completed"
      ],
      "default": "scheduled",
      "title": "Lifecycle State"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "manual",
        "booking",
        "workout",
        "business_scheduling",
        "external",
        "messaging"
      ],
      "default": "manual",
      "title": "Source System",
      "description": "Which Interactive system originated this event"
    },
    "source_id": {
      "type": "string",
      "title": "Source ID",
      "description": "Stable reference to the source record for idempotency"
    },
    "external_calendar_id": {
      "type": "string",
      "title": "External Calendar ID",
      "description": "Reference to ExternalCalendarConnection if synced"
    },
    "external_event_id": {
      "type": "string",
      "title": "External Event ID",
      "description": "ID from the external calendar provider"
    },
    "created_by_id": {
      "type": "string",
      "title": "Created By Identity ID",
      "description": "The stable Interactive identity ID that created this event. Canonical creator field \u2014 reused (not duplicated). Immutable after creation: a later authorised editor does NOT overwrite this. The creator retains edit/cancel/reschedule permission (subject to domain lifecycle restrictions such as Booking-owned events)."
    },
    "business_id": {
      "type": "string",
      "title": "Business ID",
      "description": "Business context if owner_type is business"
    },
    "recurrence_rule": {
      "type": "string",
      "title": "Recurrence Rule",
      "description": "RRULE string for recurring events (RFC 5545). When present, the event is a recurring series; individual occurrences are derived by expanding this rule. Occurrence identity is stable (seriesId__originalStart). \u00a753\u2013\u00a758."
    },
    "effective_until": {
      "type": "string",
      "format": "date-time",
      "title": "Effective Until",
      "description": "For a superseded recurring series: the last date-time up to which occurrences are generated from THIS series. Set when a 'this and future' edit creates a new series \u2014 the old series becomes historical (past occurrences only), preserving historical recurrence integrity (\u00a757). Null/absent for an active series (occurrences generated per COUNT/UNTIL)."
    },
    "superseded_by_id": {
      "type": "string",
      "title": "Superseded By Event ID",
      "description": "For a superseded series: the event ID of the replacement series that takes over from effective_until onwards. Audit link for historical recurrence integrity (\u00a757)."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Service ID",
            "description": "Canonical slug from ServiceDefinition taxonomy. Shared with Professional/Business profiles. Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Service Label"
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Services / Activity",
      "description": "Structured activity/service selections from the shared ServiceDefinition taxonomy. Reused for Directory 'Activity' filtering. Canonical entries carry an id; custom entries have id=null. Only meaningful for public events (identity-owned professional-context or business-owned events)."
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the event cover image. Owned by the event owner's identity with source_domain 'professional' or 'business'."
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL",
      "description": "Display URL for the cover image (resolved from MediaAsset). Convenience denormalisation for the public projection."
    },
    "price_pence": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "title": "Price (pence)",
      "description": "Advertised event price in pence. 0 for free events. Invariant: is_free === (price_pence === 0)."
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "title": "Currency"
    },
    "is_free": {
      "type": "boolean",
      "default": true,
      "title": "Is Free",
      "description": "Deterministic invariant: is_free === (price_pence === 0). A free event must not carry a fabricated paid price."
    },
    "capacity": {
      "type": "number",
      "minimum": 1,
      "title": "Capacity",
      "description": "Maximum number of attendees for a group event. Null/absent for non-capacity events (e.g. one-to-one slot-based bookings). When present, spaces_remaining is derived as capacity minus valid confirmed/reserved attendee quantity."
    },
    "assigned_identity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Assigned Identity IDs",
      "description": "Stable Interactive identity IDs the event is assigned/shared with (e.g. Business staff). Assignment grants VIEW/PARTICIPATION only \u2014 it NEVER grants edit/cancel/reschedule authority. Mutation authority comes from being the creator OR having Business Calendar management permission (manage_calendar). For Business-owned events these are typically staff identities; the event appears on their Calendar but they cannot mutate it unless they hold the management permission."
    },
    "invited_identity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Invited Identity IDs",
      "description": "Stable Interactive identity IDs invited to the event via email resolution. The event appears on their Calendar (one authoritative event, no duplication). Invitation grants VIEW/PARTICIPATION only \u2014 NEVER edit/cancel/reschedule authority. Edits/cancellations by the creator propagate to all invitees because there is one authoritative event."
    },
    "invited_guest_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Invited Guest Emails",
      "description": "Emails invited to the event that did NOT resolve to an existing Interactive identity at invite time. Preserved for future invitation/email communication when the recipient later joins Interactive. NEVER grants mutation permission. Email is a discovery/invitation mechanism, NOT an ownership key."
    }
  },
  "required": [
    "owner_id",
    "owner_type",
    "title",
    "start_time",
    "end_time",
    "created_by_id"
  ]
}