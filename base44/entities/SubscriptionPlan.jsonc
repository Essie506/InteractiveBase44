{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "essential",
        "growth",
        "professional"
      ],
      "title": "Plan Tier"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Features"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active",
      "title": "Plan Status"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "name",
    "tier"
  ]
}