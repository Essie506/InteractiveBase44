{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "plus",
        "pro"
      ],
      "title": "Plan Tier",
      "description": "V2 \u00a711 tier architecture: basic = Tier 1 (Core Operational Capability), plus = Tier 2 (Expanded Business Capability), pro = Tier 3 (Advanced Operational Capability). Higher tiers inherit lower-tier capabilities (\u00a712)."
    },
    "family": {
      "type": "string",
      "enum": [
        "professional",
        "business"
      ],
      "title": "Plan Family",
      "description": "V2 \u00a710: separate subscription families per operating context. Professional and Business are distinct families with independent pricing (\u00a713\u2013\u00a718). Each plan belongs to exactly one family."
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Features"
    },
    "price_pence": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "title": "Price (pence)",
      "description": "Recurring subscription price in pence. Authoritative V2 prices (\u00a713\u2013\u00a718): Professional Basic \u00a30, Professional Plus \u00a330, Professional Pro \u00a360, Business Basic \u00a3100, Business Plus \u00a3150, Business Pro \u00a3200."
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "title": "Currency"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "title": "Billing Interval",
      "description": "V2 \u00a713\u2013\u00a718 state prices per month. Annual billing is not defined by the spec; monthly is the default cadence."
    },
    "stripe_price_id": {
      "type": "string",
      "title": "Stripe Price ID",
      "description": "Stripe Price ID for the recurring subscription. Null/empty for the free tier (Professional Basic). Must be populated before live subscription activation."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active",
      "title": "Plan Status"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "fee_waiver": {
      "type": "boolean",
      "default": false,
      "title": "Fee Waiver",
      "description": "Whether this plan waives Interactive booking fees. V2 \u00a747\u2013\u00a748: the platform must NOT represent subscription price as including or waiving Booking fees unless the current commercial configuration explicitly defines that rule. No authoritative configuration currently defines any waiver \u2014 leave false."
    },
    "fee_rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "percentage",
            "flat",
            "none"
          ],
          "title": "Fee Type"
        },
        "value": {
          "type": "number",
          "title": "Fee Value",
          "description": "Percentage (e.g. 5 = 5%) or flat amount in pence"
        },
        "minimum_pence": {
          "type": "number",
          "title": "Minimum Fee (pence)"
        },
        "applies_to_free_events": {
          "type": "boolean",
          "default": false,
          "title": "Applies to Free Events"
        }
      },
      "title": "Fee Rule",
      "description": "V2 \u00a747\u2013\u00a749: Booking fees are a separate commercial mechanism from subscription price, governed by the Payments system. No authoritative commercial configuration currently defines fee values \u2014 leave this field unset until the owning Payments/commercial rules provide authoritative values. Do not assume 'none'."
    },
    "growth_package_id": {
      "type": "string",
      "title": "Growth Package ID",
      "description": "V2 \u00a719.3/\u00a719.5. Reference to the GrowthPackage that entitles this plan's promotional capabilities. Links subscription tier to Growth Package entitlements. Null for the free tier (Professional Basic) which has no promotional capabilities."
    }
  },
  "required": [
    "name",
    "tier",
    "family"
  ]
}