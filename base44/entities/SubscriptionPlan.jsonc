{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Plan Name"
    },
    "tier": {
      "type": "string",
      "enum": [
        "essential",
        "growth",
        "professional"
      ],
      "title": "Plan Tier",
      "description": "essential = Tier 1 (free core), growth = Tier 2 (Plus), professional = Tier 3 (Pro). Higher tiers inherit lower-tier capabilities."
    },
    "family": {
      "type": "string",
      "enum": [
        "professional",
        "business",
        "both"
      ],
      "default": "both",
      "title": "Plan Family",
      "description": "Which account type this plan serves. 'both' applies to professionals and businesses (shared tier structure)."
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Features"
    },
    "price_pence": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "title": "Price (pence)",
      "description": "Recurring subscription price in pence. 0 for the free tier (Tier 1). Numerical values must be populated from authoritative plan configuration before live subscription activation."
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "title": "Currency"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "title": "Billing Interval"
    },
    "stripe_price_id": {
      "type": "string",
      "title": "Stripe Price ID",
      "description": "Stripe Price ID for the recurring subscription. Null/empty for the free tier. Must be populated before live subscription activation."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active",
      "title": "Plan Status"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    },
    "fee_waiver": {
      "type": "boolean",
      "default": false,
      "title": "Fee Waiver",
      "description": "Whether this plan waives Interactive booking fees. The authoritative Plans spec determines which plans waive fees."
    },
    "fee_rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "percentage",
            "flat",
            "none"
          ],
          "title": "Fee Type"
        },
        "value": {
          "type": "number",
          "title": "Fee Value",
          "description": "Percentage (e.g. 5 = 5%) or flat amount in pence"
        },
        "minimum_pence": {
          "type": "number",
          "title": "Minimum Fee (pence)"
        },
        "applies_to_free_events": {
          "type": "boolean",
          "default": false,
          "title": "Applies to Free Events"
        }
      },
      "title": "Fee Rule",
      "description": "Data-driven fee configuration. Numerical values must be supplied via authoritative plan configuration before production payment activation."
    }
  },
  "required": [
    "name",
    "tier"
  ]
}