{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "owner_id": {
      "type": "string",
      "title": "Owner ID",
      "description": "Stable reference to the authenticated identity that created this Business"
    },
    "type": {
      "type": "string",
      "enum": [
        "gym",
        "studio",
        "clinic",
        "freelancer",
        "club",
        "charity",
        "other"
      ],
      "default": "other",
      "title": "Business Type"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "creating",
        "pending_verification",
        "active",
        "restricted",
        "protected",
        "inactive",
        "closing",
        "archived",
        "reactivating"
      ],
      "default": "creating",
      "title": "Lifecycle State"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "awaiting_verification",
        "active"
      ],
      "default": "not_started",
      "title": "Business Onboarding Status"
    },
    "onboarding_step": {
      "type": "string",
      "title": "Current Onboarding Step"
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "not_verified",
        "pending_review",
        "additional_info_required",
        "verified",
        "failed",
        "expired"
      ],
      "default": "not_verified",
      "title": "Verification State"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    }
  },
  "required": [
    "name",
    "owner_id"
  ]
}