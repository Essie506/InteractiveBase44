{
  "name": "BusinessProfile",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business ID"
    },
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "logo_media_id": {
      "type": "string",
      "title": "Logo Media ID",
      "description": "Stable reference to the MediaAsset used as the business logo"
    },
    "logo_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Logo Focal Point X",
      "description": "Horizontal focal point (0-1) for logo rendering"
    },
    "logo_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Logo Focal Point Y",
      "description": "Vertical focal point (0-1) for logo rendering"
    },
    "logo_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Logo Zoom",
      "description": "Zoom factor for logo rendering"
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the cover image"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL",
      "description": "Display URL for the cover image (resolved from MediaAsset)"
    },
    "cover_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point X"
    },
    "cover_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point Y"
    },
    "cover_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Cover Zoom"
    },
    "gallery_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery Media IDs",
      "description": "Stable references to MediaAssets in the business gallery. Owned by a business admin's identity with source_domain 'business'."
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Service ID",
            "description": "Canonical slug from ServiceDefinition taxonomy. Shared with Professional profiles. Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Service Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Services",
      "description": "Structured service selections from the shared ServiceDefinition taxonomy. Canonical entries carry an id for search/filter matching; custom entries have id=null."
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Facility ID",
            "description": "Canonical slug from FacilityDefinition taxonomy. Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Facility Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Facilities",
      "description": "Structured facility selections from the FacilityDefinition taxonomy. Canonical entries carry an id for search/filter matching; custom entries have id=null."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Equipment ID",
            "description": "Canonical slug from the EquipmentDefinition taxonomy (standardEquipment). Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Equipment Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Equipment",
      "description": "Structured equipment selections from the shared EquipmentDefinition taxonomy (standardEquipment). Canonical entries carry an id for Directory filter matching; custom entries have id=null. Conceptually separate from Facilities (structural areas vs training apparatus)."
    },
    "professionals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identity_id": {
            "type": "string",
            "title": "Identity ID",
            "description": "Reference to the professional's Interactive identity. Must be an active business member. Display info is resolved from professionalProfilesPublic for the public projection \u2014 not duplicated here."
          }
        },
        "required": [
          "identity_id"
        ]
      },
      "title": "Professionals",
      "description": "References to professional identities who are active members of this business. The public projection carries resolved display info (name, headline, avatar, screen_name) sourced from professionalProfilesPublic."
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "operating_hours": {
      "type": "string",
      "title": "Operating Hours"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "title": "Visibility"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    }
  },
  "required": [
    "business_id",
    "name"
  ]
}