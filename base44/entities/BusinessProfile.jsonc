{
  "name": "BusinessProfile",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business ID"
    },
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "logo_media_id": {
      "type": "string",
      "title": "Logo Media ID",
      "description": "Stable reference to the MediaAsset used as the business logo"
    },
    "logo_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Logo Focal Point X",
      "description": "Horizontal focal point (0-1) for logo rendering"
    },
    "logo_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Logo Focal Point Y",
      "description": "Vertical focal point (0-1) for logo rendering"
    },
    "logo_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Logo Zoom",
      "description": "Zoom factor for logo rendering"
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the cover image"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL",
      "description": "Display URL for the cover image (resolved from MediaAsset)"
    },
    "cover_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point X"
    },
    "cover_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point Y"
    },
    "cover_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Cover Zoom"
    },
    "gallery_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery Media IDs",
      "description": "Stable references to MediaAssets in the business gallery"
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Services"
    },
    "professionals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "headline": {
            "type": "string",
            "title": "Headline"
          },
          "avatar_url": {
            "type": "string",
            "title": "Avatar URL"
          },
          "screen_name": {
            "type": "string",
            "title": "Screen Name",
            "description": "Optional public handle for linking to the professional's public profile"
          }
        }
      },
      "title": "Professionals",
      "description": "Denormalized public display info for professionals associated with this business. Curated by business admins; shown on the public Business Profile."
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "operating_hours": {
      "type": "string",
      "title": "Operating Hours"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "title": "Visibility"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    }
  },
  "required": [
    "business_id",
    "name"
  ]
}