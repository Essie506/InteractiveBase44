{
  "name": "BusinessProfile",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business ID"
    },
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "logo_media_id": {
      "type": "string",
      "title": "Logo Media ID",
      "description": "Stable reference to the MediaAsset used as the business logo"
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the cover image"
    },
    "gallery_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery Media IDs",
      "description": "Stable references to MediaAssets in the business gallery"
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Services"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "operating_hours": {
      "type": "string",
      "title": "Operating Hours"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public",
      "title": "Visibility"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    }
  },
  "required": [
    "business_id",
    "name"
  ]
}