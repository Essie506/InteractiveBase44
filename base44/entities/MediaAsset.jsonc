{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "title": "Owner ID",
      "description": "Stable reference to the identity that uploaded this asset"
    },
    "file_url": {
      "type": "string",
      "title": "File URL",
      "description": "Display URL \u2014 knowing this alone does not grant access; Storage Rules enforce authorization"
    },
    "storage_path": {
      "type": "string",
      "title": "Storage Path",
      "description": "Firebase Cloud Storage path (e.g. media/{mediaId}/original) \u2014 the authoritative reference for server-side operations and Storage Rules"
    },
    "legacy_file_url": {
      "type": "string",
      "title": "Legacy File URL",
      "description": "Original Base44 URL preserved for rollback during M4 migration"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "mime_type": {
      "type": "string",
      "title": "MIME Type"
    },
    "size_bytes": {
      "type": "number",
      "title": "Size (bytes)"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "document"
      ],
      "title": "Media Type"
    },
    "width": {
      "type": "number",
      "title": "Width"
    },
    "height": {
      "type": "number",
      "title": "Height"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "pending_upload",
        "uploading",
        "validating",
        "processing",
        "active",
        "processing_failed",
        "archived",
        "scheduled_for_deletion",
        "deleted"
      ],
      "default": "pending_upload",
      "title": "Lifecycle State"
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      },
      "title": "Derivatives"
    },
    "alt_text": {
      "type": "string",
      "title": "Alt Text"
    },
    "source_domain": {
      "type": "string",
      "enum": [
        "personal",
        "professional",
        "business",
        "verification",
        "post",
        "workout",
        "promotion"
      ],
      "title": "Source Domain",
      "description": "Which connected system owns the usage context"
    },
    "source_ref_id": {
      "type": "string",
      "title": "Source Reference ID",
      "description": "Authoritative link to the source-domain entity. For messaging: conversation_id. For verification: verification_request_id. Used by Storage Rules for source-domain authorization."
    },
    "authorized_identity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Identity IDs",
      "description": "Denormalized immutable list of identities authorized to access this media. For verification evidence: [submitter_id]. Used by Storage Rules for source-domain authorization within the 2-Firestore-access limit."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private",
        "protected"
      ],
      "default": "private",
      "title": "Visibility"
    },
    "processing_error": {
      "type": "string",
      "title": "Processing Error"
    },
    "checksum": {
      "type": "string",
      "title": "Checksum",
      "description": "For deduplication/idempotency"
    }
  },
  "required": [
    "owner_id",
    "media_type"
  ]
}