{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "title": "Owner ID",
      "description": "Stable reference to the identity that uploaded this asset"
    },
    "file_url": {
      "type": "string",
      "title": "File URL",
      "description": "Display URL \u2014 knowing this alone does not grant access; Storage Rules enforce authorization"
    },
    "storage_path": {
      "type": "string",
      "title": "Storage Path",
      "description": "Firebase Cloud Storage path (e.g. media/{mediaId}/original) \u2014 the authoritative reference for server-side operations and Storage Rules"
    },
    "legacy_file_url": {
      "type": "string",
      "title": "Legacy File URL",
      "description": "Original Base44 URL preserved for rollback during M4 migration"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "mime_type": {
      "type": "string",
      "title": "MIME Type"
    },
    "size_bytes": {
      "type": "number",
      "title": "Size (bytes)"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "document"
      ],
      "title": "Media Type"
    },
    "width": {
      "type": "number",
      "title": "Width"
    },
    "height": {
      "type": "number",
      "title": "Height"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "pending_upload",
        "uploading",
        "validating",
        "processing",
        "active",
        "processing_failed",
        "quarantined",
        "updating",
        "archived",
        "scheduled_for_deletion",
        "deleted"
      ],
      "default": "pending_upload",
      "title": "Lifecycle State",
      "description": "V2 Media \u00a710 lifecycle: pending_upload \u2192 uploading \u2192 validating \u2192 processing \u2192 active. quarantined = failed security screening (\u00a711); updating = asset is being re-processed; processing_failed = transcoding/optimisation failure; archived/scheduled_for_deletion/deleted = end-of-life states."
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "Derivative Type",
            "description": "thumbnail, preview, optimized, transcoded_720p, transcoded_1080p, etc."
          },
          "url": {
            "type": "string",
            "title": "Derivative URL"
          },
          "width": {
            "type": "number",
            "title": "Width"
          },
          "height": {
            "type": "number",
            "title": "Height"
          }
        }
      },
      "title": "Derivatives",
      "description": "Generated derivatives (thumbnails, previews, transcoded renditions) produced by the Media Processing Adapter."
    },
    "alt_text": {
      "type": "string",
      "title": "Alt Text"
    },
    "source_domain": {
      "type": "string",
      "enum": [
        "personal",
        "professional",
        "business",
        "verification",
        "post",
        "workout",
        "promotion",
        "booking",
        "payment"
      ],
      "title": "Source Domain",
      "description": "Which connected system owns the usage context. booking = booking attachments/evidence; payment = receipts/invoices/payment documents."
    },
    "source_ref_id": {
      "type": "string",
      "title": "Source Reference ID",
      "description": "Authoritative link to the source-domain entity. For messaging: conversation_id. For verification: verification_request_id. For booking: booking_id. For payment: payment_id. Used by Storage Rules for source-domain authorization."
    },
    "authorized_identity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Identity IDs",
      "description": "Denormalized immutable list of identities authorized to access this media. For verification evidence: [submitter_id]. Used by Storage Rules for source-domain authorization within the 2-Firestore-access limit."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private",
        "protected"
      ],
      "default": "private",
      "title": "Visibility"
    },
    "processing_error": {
      "type": "string",
      "title": "Processing Error",
      "description": "Error message when lifecycle_state is processing_failed or quarantined."
    },
    "processing_intent": {
      "type": "object",
      "properties": {
        "screen": {
          "type": "boolean",
          "default": true,
          "title": "Security Screen Requested"
        },
        "optimize": {
          "type": "boolean",
          "default": true,
          "title": "Image Optimisation Requested"
        },
        "thumbnail": {
          "type": "boolean",
          "default": true,
          "title": "Thumbnail Generation Requested"
        },
        "transcode": {
          "type": "boolean",
          "default": true,
          "title": "Video Transcoding Requested"
        }
      },
      "title": "Processing Intent",
      "description": "Record of what processing was requested when the asset was uploaded. The Processing Adapter uses this to determine which operations to apply. Preserved for audit even when the default adapter is a no-op."
    },
    "checksum": {
      "type": "string",
      "title": "Checksum",
      "description": "For deduplication/idempotency"
    }
  },
  "required": [
    "owner_id",
    "media_type"
  ]
}