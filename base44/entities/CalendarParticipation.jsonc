{
  "name": "CalendarParticipation",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "title": "Event ID",
      "description": "Stable reference to the CalendarEvent this participation record belongs to. One authoritative event \u2014 no per-user copies."
    },
    "identity_id": {
      "type": "string",
      "title": "Identity ID",
      "description": "The invited Interactive identity. Participation state is per-identity per-event."
    },
    "response_state": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "revoked"
      ],
      "default": "pending",
      "title": "Response State",
      "description": "V2 participation state \u2014 SEPARATE from the event's lifecycle_state. pending = invited but not yet responded; accepted = identity accepted; declined = identity declined (event remains visible); revoked = organiser removed the invitation (identity loses visibility)."
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "title": "Invited At"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Responded At"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Revoked At"
    },
    "revoked_by": {
      "type": "string",
      "title": "Revoked By",
      "description": "The identity that revoked the invitation (organiser or business manager)."
    },
    "source_system": {
      "type": "string",
      "default": "calendar",
      "title": "Source System"
    },
    "personal_lifecycle_state": {
      "type": "string",
      "enum": [
        "completed",
        "skipped",
        "archived"
      ],
      "title": "Personal Lifecycle State",
      "description": "Participant's PERSONAL timeline state \u2014 SEPARATE from the canonical event lifecycle_state. A participant can independently record whether they personally completed/skipped/archived an event WITHOUT rewriting the organiser's canonical lifecycle_state. Null/absent = no personal state set. 'archived' corresponds to 'Remove from my timeline' (paired with hidden_from_timeline). This field is personal to the owning identity and is never projected to other participants or the organiser."
    },
    "hidden_from_timeline": {
      "type": "boolean",
      "default": false,
      "title": "Hidden From My Timeline",
      "description": "When true, the event is removed from THIS participant's personal Calendar view only. It does NOT delete or alter the canonical event, affect the organiser, or affect other participants. Set by the participant via 'Remove from my timeline'. Recoverable via the Calendar 'Show hidden' filter. Only meaningful for non-owner participants (owners use the canonical archive/delete)."
    }
  },
  "required": [
    "event_id",
    "identity_id",
    "response_state"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}