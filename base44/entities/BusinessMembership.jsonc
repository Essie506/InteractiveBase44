{
  "name": "BusinessMembership",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "title": "Business ID",
      "description": "Stable reference to the Business"
    },
    "identity_id": {
      "type": "string",
      "title": "Identity ID",
      "description": "Stable reference to the authenticated Interactive identity"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "staff",
        "member"
      ],
      "default": "member",
      "title": "Role"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Additional Permissions",
      "description": "Individual permission overrides beyond role defaults"
    },
    "invited_by_id": {
      "type": "string",
      "title": "Invited By ID",
      "description": "Identity that invited this member"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "invited",
        "suspended",
        "removed",
        "historical"
      ],
      "default": "active",
      "title": "Lifecycle State"
    }
  },
  "required": [
    "business_id",
    "identity_id",
    "role"
  ]
}