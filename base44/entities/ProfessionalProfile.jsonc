{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "identity_id": {
      "type": "string",
      "title": "Identity ID",
      "description": "Stable reference to the authenticated Interactive identity (User)"
    },
    "legal_name": {
      "type": "string",
      "title": "Legal Name",
      "description": "Professional's real/legal identity. Used for account/verification purposes only. Never copied into the public projection unless explicitly required by a future policy."
    },
    "business_name": {
      "type": "string",
      "title": "Business / Trading Name",
      "description": "Optional trading identity. May be publicly displayed."
    },
    "display_name": {
      "type": "string",
      "title": "Display Name",
      "description": "Primary public-facing name presented on the Professional Profile"
    },
    "screen_name": {
      "type": "string",
      "title": "Screen Name",
      "description": "Public handle for the /p/:screenName route. Uniqueness enforced server-side. Lowercase, 3-20 chars, alphanumeric + underscore."
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL"
    },
    "avatar_media_id": {
      "type": "string",
      "title": "Avatar Media ID",
      "description": "Stable reference to the MediaAsset used as the professional profile image"
    },
    "avatar_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Avatar Focal Point X",
      "description": "Horizontal focal point (0-1) for avatar rendering"
    },
    "avatar_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Avatar Focal Point Y",
      "description": "Vertical focal point (0-1) for avatar rendering"
    },
    "avatar_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Avatar Zoom",
      "description": "Zoom factor for avatar rendering"
    },
    "cover_media_id": {
      "type": "string",
      "title": "Cover Media ID",
      "description": "Stable reference to the MediaAsset used as the cover/header image"
    },
    "cover_url": {
      "type": "string",
      "title": "Cover URL",
      "description": "Display URL for the cover image (resolved from MediaAsset)"
    },
    "cover_position_x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point X"
    },
    "cover_position_y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "title": "Cover Focal Point Y"
    },
    "cover_zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "title": "Cover Zoom"
    },
    "gallery_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Gallery Media IDs",
      "description": "Stable references to MediaAssets in the professional gallery. Owned by the professional's identity with source_domain 'professional'."
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "headline": {
      "type": "string",
      "title": "Headline"
    },
    "profession": {
      "type": "string",
      "title": "Profession",
      "description": "Free-text profession field. Retained for backward compatibility; prefer the structured professional_type field for filter matching."
    },
    "professional_category": {
      "type": "string",
      "title": "Professional Category",
      "description": "Free-text category field. Retained for backward compatibility; prefer the structured professional_type field for filter matching."
    },
    "professional_type": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "Professional Type ID",
          "description": "Canonical slug from the ProfessionalType taxonomy (standardProfessionalTypes). Null for custom free-text entries."
        },
        "label": {
          "type": "string",
          "title": "Professional Type Label",
          "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
        }
      },
      "title": "Professional Type",
      "description": "Canonical professional type from the ProfessionalType taxonomy. A single { id, label } value \u2014 a professional is one type. Distinct from Services (what you offer) and Specialisms (your area of expertise)."
    },
    "specialisms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Specialism ID",
            "description": "Canonical slug from the SpecialismDefinition taxonomy (standardSpecialisms). Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Specialism Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Specialisms",
      "description": "Structured specialism selections from the shared SpecialismDefinition taxonomy (standardSpecialisms). Canonical entries carry an id for Directory filter matching; custom entries have id=null. A Specialism is an area of expertise (e.g. Beginners, Strength), conceptually distinct from a Service (what you offer)."
    },
    "session_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Session Type ID",
            "description": "Canonical slug from the SessionTypeDefinition taxonomy (standardSessionTypes). Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Session Type Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Session Types",
      "description": "Structured session type selections from the SessionTypeDefinition taxonomy (standardSessionTypes). Canonical entries carry an id for Directory filter matching; custom entries have id=null. Describes how sessions are delivered (e.g. 1-to-1, Group, Online, Outdoor)."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "Service ID",
            "description": "Canonical slug from ServiceDefinition taxonomy. Null for custom free-text entries."
          },
          "label": {
            "type": "string",
            "title": "Service Label",
            "description": "Display label. Matches the taxonomy label for canonical entries; user-entered for custom entries."
          }
        },
        "required": [
          "label"
        ]
      },
      "title": "Services",
      "description": "Structured service selections. Canonical entries carry an id for search/filter matching; custom entries have id=null."
    },
    "service_area": {
      "type": "string",
      "title": "Service Area (display)"
    },
    "service_area_location_id": {
      "type": "string",
      "title": "Service Area Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email",
      "description": "Private account contact email. Never projected to any public collection. Use public_contact.email for the advert-facing email."
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone",
      "description": "Private account contact phone. Never projected to any public collection. Use public_contact.phone for the advert-facing phone."
    },
    "website": {
      "type": "string",
      "title": "Website",
      "description": "Single authoritative Professional website URL. Exposed in the Directory advert only when public_contact.website_visible is true."
    },
    "public_contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "title": "Public Professional Email",
          "description": "Explicit public contact email for the Directory advert. Separate from the private account contact_email."
        },
        "email_visible": {
          "type": "boolean",
          "default": false,
          "title": "Public Email Visible"
        },
        "phone": {
          "type": "string",
          "title": "Public Professional Phone",
          "description": "Explicit public contact phone for the Directory advert. Separate from the private account contact_phone."
        },
        "phone_visible": {
          "type": "boolean",
          "default": false,
          "title": "Public Phone Visible"
        },
        "website_visible": {
          "type": "boolean",
          "default": false,
          "title": "Website Visible in Directory",
          "description": "Controls whether the top-level website field is exposed in the Directory advert. The website field remains the single source of truth for the URL."
        }
      },
      "title": "Public Professional Contact",
      "description": "Explicit Professional-controlled public contact information for the Directory advert. Separate from private account contact_email/contact_phone. Only projected to professionalDirectoryEntries when the corresponding *_visible flag is true."
    },
    "public_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "title": "Day"
          },
          "open": {
            "type": "string",
            "title": "Open",
            "description": "Opening time, HH:MM 24h"
          },
          "close": {
            "type": "string",
            "title": "Close",
            "description": "Closing time, HH:MM 24h"
          },
          "closed": {
            "type": "boolean",
            "default": false,
            "title": "Closed"
          }
        },
        "required": [
          "day"
        ]
      },
      "title": "Public / Contact Hours",
      "description": "Informational public contact hours (when the professional is usually contactable). NOT Calendar availability \u2014 these are not bookable slots."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private"
      ],
      "default": "public",
      "title": "Profile Visibility",
      "description": "Controls who can view the FULL Professional Profile. public = anyone; connections = owner + accepted Connections; private = owner only. Independent of directory_visibility."
    },
    "directory_visibility": {
      "type": "string",
      "enum": [
        "listed",
        "unlisted"
      ],
      "default": "unlisted",
      "title": "Directory Visibility",
      "description": "Controls whether a public Professional advert is published to the Directory. Independent of profile visibility. 'listed' publishes a discovery-safe advert to professionalDirectoryEntries; 'unlisted' removes the advert but does not change who can view the full profile."
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "awaiting_verification",
        "active"
      ],
      "default": "not_started",
      "title": "Professional Onboarding Status"
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "not_verified",
        "pending_review",
        "additional_info_required",
        "verified",
        "failed",
        "expired"
      ],
      "default": "not_verified",
      "title": "Verification State"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Activated At"
    },
    "away_message": {
      "type": "string",
      "title": "Away Message",
      "description": "Auto-response message sent when a professional is unavailable"
    },
    "away_message_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Away Message Enabled"
    }
  },
  "required": [
    "identity_id",
    "display_name"
  ]
}