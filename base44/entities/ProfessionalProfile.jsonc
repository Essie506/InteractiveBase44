{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "identity_id": {
      "type": "string",
      "title": "Identity ID",
      "description": "Stable reference to the authenticated Interactive identity (User)"
    },
    "display_name": {
      "type": "string",
      "title": "Display Name"
    },
    "screen_name": {
      "type": "string",
      "title": "Screen Name"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL"
    },
    "avatar_media_id": {
      "type": "string",
      "title": "Avatar Media ID",
      "description": "Stable reference to the MediaAsset used as the professional profile image"
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "headline": {
      "type": "string",
      "title": "Headline"
    },
    "profession": {
      "type": "string",
      "title": "Profession"
    },
    "professional_category": {
      "type": "string",
      "title": "Professional Category"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Services / Specialisms"
    },
    "service_area": {
      "type": "string",
      "title": "Service Area (display)"
    },
    "service_area_location_id": {
      "type": "string",
      "title": "Service Area Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "location": {
      "type": "string",
      "title": "Location (display)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID",
      "description": "Stable reference to the authoritative Location record"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "connections",
        "private"
      ],
      "default": "public",
      "title": "Visibility"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "awaiting_verification",
        "active"
      ],
      "default": "not_started",
      "title": "Professional Onboarding Status"
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "not_verified",
        "pending_review",
        "additional_info_required",
        "verified",
        "failed",
        "expired"
      ],
      "default": "not_verified",
      "title": "Verification State"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft",
      "title": "Lifecycle State"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Activated At"
    },
    "away_message": {
      "type": "string",
      "title": "Away Message",
      "description": "Auto-response message sent when a professional is unavailable"
    },
    "away_message_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Away Message Enabled"
    }
  },
  "required": [
    "identity_id",
    "display_name"
  ]
}