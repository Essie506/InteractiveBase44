rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // REUSABLE HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── Identity Mapping ─────────────────────────────────────────
    // Firebase Auth UID → stable Interactive Identity ID.
    //
    // Domain records reference the Interactive Identity ID, not the
    // Auth UID, so authentication providers can change without
    // altering domain identity keys throughout Interactive.
    //
    // hasIdentityMapping() returns a boolean — whether the caller
    // has an identity mapping. getIdentityId() returns the identity
    // ID string — only safe to call after hasIdentityMapping() is
    // true. This split ensures rule expressions always evaluate to
    // booleans, not strings.

    function hasIdentityMapping() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/identityMappings/$(uid()));
    }

    function getIdentityId() {
      return get(/databases/$(database)/documents/identityMappings/$(uid())).data.identity_id;
    }

    function isOwner(identityId) {
      return hasIdentityMapping() && getIdentityId() == identityId;
    }

    function userExists(identityId) {
      return exists(/databases/$(database)/documents/users/$(identityId));
    }

    function userDoc(identityId) {
      return get(/databases/$(database)/documents/users/$(identityId)).data;
    }

    function isAdmin() {
      return hasIdentityMapping()
        && userExists(getIdentityId())
        && userDoc(getIdentityId()).role == 'admin';
    }

    function isReviewer() {
      return hasIdentityMapping()
        && userExists(getIdentityId())
        && userDoc(getIdentityId()).role in ['admin', 'reviewer'];
    }

    // Business membership — deterministic doc ID: {businessId}_{identityId}
    function membershipId(businessId, identityId) {
      return businessId + '_' + identityId;
    }

    function isBusinessMember(businessId) {
      return hasIdentityMapping()
        && exists(/databases/$(database)/documents/businessMemberships/$(membershipId(businessId, getIdentityId())));
    }

    function membershipData(businessId) {
      return get(/databases/$(database)/documents/businessMemberships/$(membershipId(businessId, getIdentityId()))).data;
    }

    function hasBusinessRole(businessId, role) {
      return isBusinessMember(businessId) && membershipData(businessId).role == role;
    }

    function isBusinessAdmin(businessId) {
      return hasBusinessRole(businessId, 'owner') || hasBusinessRole(businessId, 'admin');
    }

    function isBusinessOwner(businessId) {
      return hasBusinessRole(businessId, 'owner');
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return hasIdentityMapping()
        && conversationExists(conversationId)
        && getIdentityId() in conversationData(conversationId).participant_ids;
    }

    function isConversationAccepted(conversationId) {
      return isAuthenticated()
        && conversationExists(conversationId)
        && conversationData(conversationId).request_status == 'accepted';
    }

    function isNotificationRecipient(resource) {
      return isOwner(resource.data.recipient_id);
    }

    function isPubliclyVisible(resource) {
      return resource.data.visibility == 'public';
    }

    // Block check — deterministic doc ID: {blockerId}__{blockedId}
    function isNotBlockedBy(blockerId, blockedId) {
      return !exists(/databases/$(database)/documents/blockRecords/$(blockerId + '__' + blockedId));
    }

    function isInvitationForAuthUser(resource) {
      return isAuthenticated()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
    }

    // ═══════════════════════════════════════════════════════════
    // IDENTITY MAPPINGS — Firebase Auth UID → Interactive Identity ID
    // Created by Cloud Function on first sign-in. Read-only for the
    // authenticated user; no client writes.
    // ═══════════════════════════════════════════════════════════

    match /identityMappings/{authUid} {
      allow read: if isAuthenticated() && uid() == authUid;
      allow write: if false; // Server-only — Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // USERS — APPLICATION IDENTITY STATE
    // Doc ID == Interactive Identity ID (not Firebase Auth UID).
    // Created by Cloud Function alongside the identity mapping.
    // ═══════════════════════════════════════════════════════════

    match /users/{identityId} {
      allow read: if isOwner(identityId) || isAdmin();
      allow create: if false; // Server-only — Cloud Function
      // ── Field-diff update policy ──
      // Client-editable: display_name, avatar_url, onboarding_status,
      //   active_context, professional_activated, terms_accepted,
      //   search_visibility
      // Immutable (owner): email (identity integrity — tied to Firebase
      //   Auth and identityMappings), role (privilege — server-authoritative
      //   via setUserRole Cloud Function)
      // Admin: unrestricted
      allow update: if (isOwner(identityId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // PERSONAL PROFILES
    // ═══════════════════════════════════════════════════════════

    match /personalProfiles/{profileId} {
      // Private collection — owner and admin only. Public reads use
      // the personalProfilesPublic projection.
      allow read: if isOwner(resource.data.identity_id)
        || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id);
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    match /personalProfilesPublic/{screenName} {
      // Public projection — public fields only. Doc ID == lowercased
      // screen_name. Readable by anyone (including unauthenticated guests)
      // so public profiles can be viewed at /u/:screenName.
      // Maintained by the savePersonalProfile Cloud Function (server-only).
      allow read: if true;
      allow write: if false; // Server-only — projection maintained by Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // PROFESSIONAL PROFILES
    // ═══════════════════════════════════════════════════════════

    match /professionalProfiles/{profileId} {
      // Private collection — owner and admin only. Public reads use
      // the professionalProfilesPublic projection (M3 §27 hardening).
      allow read: if isOwner(resource.data.identity_id)
        || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id) || isAdmin();
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    match /professionalProfilesPublic/{screenName} {
      // Public projection — public fields only (no legal_name,
      // contact_email, contact_phone, away_message, onboarding_status,
      // or activated_at). Doc ID == lowercased screen_name.
      // Readable by anyone (including unauthenticated guests) so public
      // profiles can be viewed at /p/:screenName.
      // Maintained by the saveProfessionalProfile Cloud Function (server-only).
      allow read: if true;
      allow write: if false; // Server-only — projection maintained by Cloud Function
    }

    match /professionalDirectoryEntries/{screenName} {
      // Directory advert projection — discovery-safe advert fields only.
      // Independent of professionalProfilesPublic: a profile appears here
      // when lifecycle_state === 'active' && directory_visibility === 'listed',
      // regardless of profile visibility (public / connections / private).
      // Contains ONLY advert-safe data (no legal_name, no private
      // contact_email/contact_phone, no away_message, no onboarding fields,
      // no bio, no gallery). Public contact (email/phone/website) is included
      // ONLY when the professional has explicitly enabled the corresponding
      // *_visible flag.
      // Readable by anyone (including unauthenticated guests) so listed
      // professionals can be discovered in the Directory.
      // Maintained by the saveProfessionalProfile Cloud Function (server-only).
      allow read: if true;
      allow write: if false; // Server-only — projection maintained by Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // BUSINESSES
    // ═══════════════════════════════════════════════════════════

    match /businesses/{businessId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(request.resource.data.owner_id);
      allow update: if isBusinessAdmin(businessId) || isAdmin();
      allow delete: if isBusinessOwner(businessId) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // BUSINESS PROFILES
    // ═══════════════════════════════════════════════════════════

    match /businessProfiles/{profileId} {
      // Private collection — business members and admin only. Public reads
      // use the businessProfilesPublic projection.
      allow read: if isBusinessMember(resource.data.business_id)
        || isAdmin();
      allow create: if isBusinessAdmin(request.resource.data.business_id);
      allow update: if isBusinessAdmin(resource.data.business_id) || isAdmin();
      allow delete: if isBusinessOwner(resource.data.business_id) || isAdmin();
    }

    match /businessProfilesPublic/{businessId} {
      // Public projection — public fields only (merged from
      // businessProfiles + businesses.verification_state). Doc ID == business_id.
      // Readable by anyone (including unauthenticated guests) so public
      // business profiles can be viewed at /b/:businessId.
      // Maintained by the saveBusinessProfile Cloud Function (server-only).
      allow read: if true;
      allow write: if false; // Server-only — projection maintained by Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // BUSINESS MEMBERSHIPS
    // Deterministic doc ID: {businessId}_{identityId}
    // ═══════════════════════════════════════════════════════════

    match /businessMemberships/{membershipId} {
      allow read: if isOwner(resource.data.identity_id)
        || isBusinessAdmin(resource.data.business_id)
        || isAdmin();
      allow create: if isAuthenticated()
        && isBusinessAdmin(request.resource.data.business_id)
        && request.resource.data.identity_id != getIdentityId()
        && request.resource.data.role != 'owner';
      allow update: if (isBusinessAdmin(resource.data.business_id)
          && resource.data.identity_id != getIdentityId()
          && request.resource.data.role != 'owner'
          && request.resource.data.role in ['admin', 'staff', 'member'])
        || (isOwner(resource.data.identity_id)
          && request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if isBusinessAdmin(resource.data.business_id)
        || isOwner(resource.data.identity_id)
        || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // BUSINESS INVITATIONS
    // ═══════════════════════════════════════════════════════════

    match /businessInvitations/{invitationId} {
      allow read: if isBusinessAdmin(resource.data.business_id)
        || isInvitationForAuthUser(resource)
        || isAdmin();
      allow create: if isAuthenticated()
        && isBusinessAdmin(request.resource.data.business_id);
      allow update: if isBusinessAdmin(resource.data.business_id)
        || isInvitationForAuthUser(resource)
        || isAdmin();
      allow delete: if isBusinessAdmin(resource.data.business_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // SUBSCRIPTION PLANS — admin-managed
    // ═══════════════════════════════════════════════════════════

    match /subscriptionPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // SERVICE DEFINITIONS — canonical service taxonomy (shared)
    // Admin-managed. Read by authenticated users for profile selection.
    // ═══════════════════════════════════════════════════════════

    match /serviceDefinitions/{defId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // FACILITY DEFINITIONS — canonical facility taxonomy (business)
    // Admin-managed. Read by authenticated users for profile selection.
    // ═══════════════════════════════════════════════════════════

    match /facilityDefinitions/{defId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // BUSINESS SUBSCRIPTIONS
    // ═══════════════════════════════════════════════════════════

    match /businessSubscriptions/{subscriptionId} {
      allow read: if isBusinessAdmin(resource.data.business_id) || isAdmin();
      allow create: if isBusinessAdmin(request.resource.data.business_id);
      allow update: if isBusinessAdmin(resource.data.business_id) || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // ONBOARDING STATES
    // ═══════════════════════════════════════════════════════════

    match /onboardingStates/{stateId} {
      allow read: if isOwner(resource.data.identity_id) || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id);
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // USER SETTINGS
    // ═══════════════════════════════════════════════════════════

    match /userSettings/{settingsId} {
      allow read: if isOwner(resource.data.identity_id) || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id);
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATION PREFERENCES
    // ═══════════════════════════════════════════════════════════

    match /notificationPreferences/{prefId} {
      allow read: if isOwner(resource.data.identity_id) || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id);
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATION RECORDS
    // ═══════════════════════════════════════════════════════════

    match /notificationRecords/{notificationId} {
      allow read: if isNotificationRecipient(resource) || isAdmin();
      allow create: if false; // Server-only — Cloud Function required
      allow update: if isNotificationRecipient(resource)
        && request.resource.data.recipient_id == resource.data.recipient_id;
      allow delete: if isNotificationRecipient(resource) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATION DELIVERIES (outbox)
    // ───────────────────────────────────────────────────────────
    // Server-only delivery/outbox records. Tracks per-channel delivery
    // state (pending/processing/sent/failed/retryable) for the
    // notification dispatcher. Clients never read or write this
    // collection — the Admin SDK bypasses these rules, and the
    // delivery worker + scheduled sweep are the only writers.
    // The user-facing delivery surface is the optional delivery_summary
    // denormalised onto notificationRecords, not this collection.
    match /notificationDeliveries/{deliveryId} {
      allow read: if false;  // Server-only
      allow write: if false; // Server-only — Admin SDK bypasses
    }

    // ═══════════════════════════════════════════════════════════
    // MEDIA ASSETS
    // ═══════════════════════════════════════════════════════════

    match /mediaAssets/{mediaId} {
      allow read: if isOwner(resource.data.owner_id)
        || isPubliclyVisible(resource)
        || isAdmin();
      // authorized_identity_ids is server-authoritative — clients
      // cannot set it on create. Only null (absent) is permitted.
      // .get() safely handles absence of the optional field.
      allow create: if isOwner(request.resource.data.owner_id)
        && request.resource.data.get('authorized_identity_ids', null) == null;
      // ── Field-diff update policy ──
      // Uses diff().affectedKeys() to detect field changes without
      // requiring optional fields to exist on the document.
      //
      // Client-editable: alt_text, derivatives, processing_error,
      //   checksum, width, height, visibility, lifecycle_state
      //   (subject to protected-media restrictions below)
      // Immutable (owner): owner_id, source_domain,
      //   authorized_identity_ids, legacy_file_url
      // Set-once (owner): source_ref_id, storage_path, file_url
      //   — may be set from null/absent, but not changed once set
      // Conditional: visibility & lifecycle_state — owner can
      //   decrease access (archive, schedule deletion) but cannot
      //   escalate protected media (verification, messaging) to
      //   public visibility or reactivate archived/deleted protected
      //   media to active state
      // Admin: unrestricted
      allow update: if (isOwner(resource.data.owner_id)
          // ── Truly immutable fields: must not appear in affected keys ──
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['owner_id', 'source_domain',
                       'authorized_identity_ids', 'legacy_file_url'])
          // ── Set-once fields: blocked from change once already set ──
          && !(resource.data.get('source_ref_id', null) != null
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['source_ref_id']))
          && !(resource.data.get('storage_path', null) != null
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['storage_path']))
          && !(resource.data.get('file_url', null) != null
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['file_url']))
          // ── Protected media: no visibility escalation to public ──
          && !(resource.data.get('source_domain', null) in ['verification', 'messaging']
              && request.resource.data.get('visibility', null) == 'public'
              && resource.data.get('visibility', null) != 'public')
          // ── Protected media: no lifecycle reactivation ──
          && !(resource.data.get('source_domain', null) in ['verification', 'messaging']
              && resource.data.get('lifecycle_state', null)
                  in ['archived', 'scheduled_for_deletion', 'deleted']
              && request.resource.data.get('lifecycle_state', null) == 'active')
        ) || isAdmin();
      allow delete: if isOwner(resource.data.owner_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // VERIFICATION REQUESTS
    // ═══════════════════════════════════════════════════════════

    match /verificationRequests/{requestId} {
      allow read: if isOwner(resource.data.submitted_by_id) || isReviewer();
      allow create: if isOwner(request.resource.data.submitted_by_id)
        && request.resource.data.status == 'pending_review'
        && request.resource.data.decision == 'pending';
      allow update: if (isOwner(resource.data.submitted_by_id)
          && request.resource.data.status == resource.data.status
          && request.resource.data.decision == resource.data.decision)
        || isReviewer();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // TRUST RECORDS
    // ═══════════════════════════════════════════════════════════

    match /trustRecords/{trustId} {
      allow read: if isOwner(resource.data.target_id) || isAdmin();
      allow create: if isReviewer();
      allow update: if isReviewer();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // TRUST SIGNALS
    // ═══════════════════════════════════════════════════════════

    match /trustSignals/{signalId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only — Cloud Function required
    }

    // ═══════════════════════════════════════════════════════════
    // LOCATIONS
    // ═══════════════════════════════════════════════════════════

    match /locations/{locationId} {
      // Private collection — owner and admin only. Public reads use
      // the locationsPublic projection (M3 §26 hardening).
      // Private fields (latitude, longitude, address_line1, postal_code)
      // are never exposed through public reads.
      allow read: if isOwner(resource.data.owner_id)
        || isAdmin();
      allow create: if isOwner(request.resource.data.owner_id);
      allow update: if isOwner(resource.data.owner_id) || isAdmin();
      allow delete: if isOwner(resource.data.owner_id) || isAdmin();
    }

    match /locationsPublic/{locationId} {
      // Public projection — public fields only (no latitude, longitude,
      // address_line1, address_line2, postal_code, label).
      // Maintained by migration/Cloud Function (server-only writes).
      allow read: if isAuthenticated();
      allow write: if false; // Server-only — projection maintained by migration
    }

    // ═══════════════════════════════════════════════════════════
    // CALENDAR EVENTS — PUBLIC PROJECTION
    // ═══════════════════════════════════════════════════════════

    match /calendarEventsPublic/{eventId} {
      // Public projection — public-safe fields only (no meeting_url,
      // no attendee identities, no private booking records). Doc ID == eventId.
      // Readable by anyone (including unauthenticated guests) so public
      // events can be discovered in the Directory and viewed at /e/:eventId.
      // Maintained by the saveCalendarEvent Cloud Function (server-only).
      allow read: if true;
      allow write: if false; // Server-only — projection maintained by Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // CALENDAR EVENTS
    // ═══════════════════════════════════════════════════════════

    match /calendarEvents/{eventId} {
      // Private collection — owner, authorised business members, and
      // admins only. Generic authenticated users can NO LONGER read the
      // full private event merely because visibility == 'public' or
      // 'connections'. Public discovery uses the calendarEventsPublic
      // projection (public-read, no meeting_url / private fields).
      // Attendees receive attendance-specific info via their booking
      // record, not via calendarEvents — no authorised-attendee clause.
      allow read: if isOwner(resource.data.owner_id)
        || (resource.data.business_id != null
          && isBusinessMember(resource.data.business_id))
        || (hasIdentityMapping()
          && getIdentityId() in resource.data.get('assigned_identity_ids', []))
        || (hasIdentityMapping()
          && getIdentityId() in resource.data.get('invited_identity_ids', []))
        || isAdmin();
      // All writes are server-only — the canonical saveCalendarEvent
      // Cloud Function is the sole authoritative writer (Admin SDK
      // bypasses these rules). Booking/system writers are likewise
      // server-side. Direct client create/update/delete is denied so
      // the canonical writer cannot be bypassed.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /calendarEventIdempotency/{idempKey} {
      // Server-only idempotency mapping for canonical event creation.
      // Clients never read or write this collection.
      allow read: if false;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // AVAILABILITY RULES
    // ═══════════════════════════════════════════════════════════

    match /availabilityRules/{ruleId} {
      // Professional availability is readable by any authenticated user
      // so the booking flow can resolve slots. Business availability
      // remains member-only.
      allow read: if isOwner(resource.data.owner_id)
        || (resource.data.owner_type == 'identity' && isAuthenticated())
        || (resource.data.business_id != null && isBusinessMember(resource.data.business_id))
        || isAdmin();
      allow create: if isOwner(request.resource.data.owner_id);
      allow update: if isOwner(resource.data.owner_id)
        || (resource.data.business_id != null && isBusinessAdmin(resource.data.business_id))
        || isAdmin();
      allow delete: if isOwner(resource.data.owner_id)
        || (resource.data.business_id != null && isBusinessAdmin(resource.data.business_id))
        || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // EXTERNAL CALENDAR CONNECTIONS
    // ═══════════════════════════════════════════════════════════

    match /externalCalendarConnections/{connectionId} {
      allow read: if isOwner(resource.data.identity_id) || isAdmin();
      allow create: if isOwner(request.resource.data.identity_id);
      allow update: if isOwner(resource.data.identity_id);
      allow delete: if isOwner(resource.data.identity_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // CONVERSATIONS & MESSAGES
    // ═══════════════════════════════════════════════════════════

    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(conversationId) || isAdmin();
      allow create: if false; // Server-only — Cloud Function required
      allow update: if isConversationParticipant(conversationId) || isAdmin();
      allow delete: if isConversationParticipant(conversationId) || isAdmin();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId) || isAdmin();
        allow create: if isOwner(request.resource.data.sender_id)
          && isConversationParticipant(conversationId)
          && isConversationAccepted(conversationId);
        allow update: if isOwner(resource.data.sender_id) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // BLOCK RECORDS
    // Deterministic doc ID: {blockerId}__{blockedId}
    // ═══════════════════════════════════════════════════════════

    match /blockRecords/{blockId} {
      allow read: if isOwner(resource.data.blocker_id) || isAdmin();
      allow create: if isOwner(request.resource.data.blocker_id);
      allow update: if isOwner(resource.data.blocker_id);
      allow delete: if isOwner(resource.data.blocker_id) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // CONNECTION REQUESTS (Relationship System)
    // ───────────────────────────────────────────────────────────
    // Server-only writes (Cloud Functions). Requester and target can
    // read their own requests. No client may forge an accepted Connection
    // — status transitions are enforced server-side by
    // respondConnectionRequest (only the target may accept/decline).
    // ═══════════════════════════════════════════════════════════

    match /connectionRequests/{requestId} {
      allow read: if isOwner(resource.data.requester_id)
        || isOwner(resource.data.target_id)
        || isAdmin();
      allow write: if false; // Server-only — Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // CONNECTIONS (Relationship System)
    // ───────────────────────────────────────────────────────────
    // Canonical identity-pair relationship. Deterministic doc ID:
    // {identityA}__{identityB} (sorted) so there is at most one
    // Connection per identity pair. Server-only writes; either
    // participant can read their own connection.
    // ═══════════════════════════════════════════════════════════

    match /connections/{connectionId} {
      allow read: if isOwner(resource.data.identity_a_id)
        || isOwner(resource.data.identity_b_id)
        || isAdmin();
      allow write: if false; // Server-only — Cloud Function
    }

    // ═══════════════════════════════════════════════════════════
    // PHASE 5 — BOOKING + PAYMENTS
    // ───────────────────────────────────────────────────────────
    // All financial transitions are server-only (Cloud Functions).
    // Clients can read their own bookings/payments/receipts but
    // cannot modify payment-related fields, booking status, Stripe
    // IDs, price/fee snapshots, or refund status.
    // ═══════════════════════════════════════════════════════════

    match /bookings/{bookingId} {
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.customer_identity_id
          || getIdentityId() == resource.data.provider_identity_id
          || (resource.data.business_id != null
            && isBusinessMember(resource.data.business_id))
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions create/update bookings
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /paymentRecords/{paymentRecordId} {
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.payer_identity_id
          || getIdentityId() == resource.data.provider_identity_id
          || (resource.data.business_id != null
            && isBusinessMember(resource.data.business_id))
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions manage payment records
      allow write: if false;
    }

    match /refundRecords/{refundRecordId} {
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.requester_identity_id
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions manage refund records
      allow write: if false;
    }

    match /receipts/{receiptId} {
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.customer_snapshot.identity_id
          || getIdentityId() == resource.data.provider_snapshot.identity_id
          || (resource.data.provider_snapshot.business_id != null
            && isBusinessMember(resource.data.provider_snapshot.business_id))
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions create receipts
      allow write: if false;
    }

    match /slotHolds/{holdId} {
      // Slot holds are internal — only the creator and admin can read
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.created_by_identity_id
          || getIdentityId() == resource.data.provider_identity_id
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions manage holds
      allow write: if false;
    }

    match /stripeConnectAccounts/{accountId} {
      // Private — only the owner or business admin can read
      allow read: if hasIdentityMapping()
        && (
          getIdentityId() == resource.data.identity_id
          || (resource.data.business_id != null
            && isBusinessMember(resource.data.business_id))
          || isAdmin()
        );
      // All writes are server-only — Cloud Functions manage Connect accounts
      allow write: if false;
    }

    match /processedStripeEvents/{eventId} {
      // Internal idempotency records — server-only
      allow read: if false;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // SPECVAULT — PROJECTS, SPECIFICATIONS, VERSIONS
    // ═══════════════════════════════════════════════════════════

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /specifications/{specId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /specVersions/{versionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // Versions are immutable
      allow delete: if isAdmin();
    }

  }
}